<?php

declare(strict_types=1);

namespace App\Services\Company\Intelligence;

use App\Services\Company\Classification\BusinessRoleResolver;
use App\Models\Company;
use Illuminate\Support\Str;

class BusinessRoleService
{
    /**
     * ==========================================================================
     * DIGESTEX BUSINESS ROLE SERVICE
     * ==========================================================================
     *
     * Determines the primary business role of a company
     * within the global textile value chain.
     *
     * Version 1
     * ---------
     * Legacy Directory
     *
     * Future versions:
     *
     * - Company Self Update
     * - Multiple Business Roles
     * - Executive AI Classification
     *
     * Returns one of the keys defined in:
     *
     * config/textile_ecosystem.php
     *
     * Examples:
     *
     * fiber
     * spinning
     * knitting
     * weaving
     * dyeing
     * garment
     * home_textile
     * technical_textile
     * brand
     * buying_office
     *
     */

    public function __construct(
        protected BusinessRoleResolver $canonicalResolver,
    ) {
    }

    public function resolve(
        Company $company
    ): string {

        $text = Str::lower(
            implode(' ', [

                $company->category,

                $company->sektor,

                $company->produk,

                $company->nama_perusahaan,

            ])
        );

        return match (true) {

            /*
            |--------------------------------------------------------------------------
            | Fiber
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'fiber'),
            str_contains($text, 'cotton'),
            str_contains($text, 'polyester staple')
                => 'fiber',

            /*
            |--------------------------------------------------------------------------
            | Spinning
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'spinning'),
            str_contains($text, 'yarn')
                => 'spinning',

            /*
            |--------------------------------------------------------------------------
            | Knitting
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'knitting'),
            str_contains($text, 'knit'),
            str_contains($text, 'rajut')
                => 'knitting',

            /*
            |--------------------------------------------------------------------------
            | Weaving
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'weaving'),
            str_contains($text, 'woven'),
            str_contains($text, 'tenun')
                => 'weaving',

            /*
            |--------------------------------------------------------------------------
            | Dyeing
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'dyeing'),
            str_contains($text, 'finishing'),
            str_contains($text, 'printing')
                => 'dyeing',

            /*
            |--------------------------------------------------------------------------
            | Garment
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'garment'),
            str_contains($text, 'apparel'),
            str_contains($text, 'fashion'),
            str_contains($text, 'underwear'),
            str_contains($text, 'shirt'),
            str_contains($text, 'pants')
                => 'garment',

            /*
            |--------------------------------------------------------------------------
            | Home Textile
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'home textile'),
            str_contains($text, 'bed sheet'),
            str_contains($text, 'towel'),
            str_contains($text, 'curtain')
                => 'home_textile',

            /*
            |--------------------------------------------------------------------------
            | Technical Textile
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'technical textile'),
            str_contains($text, 'nonwoven'),
            str_contains($text, 'geotextile'),
            str_contains($text, 'medical textile')
                => 'technical_textile',

            /*
            |--------------------------------------------------------------------------
            | Brand
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'brand')
                => 'brand',

            /*
            |--------------------------------------------------------------------------
            | Buying Office
            |--------------------------------------------------------------------------
            */

            str_contains($text, 'buying office'),
            str_contains($text, 'sourcing')
                => 'buying_office',

            default => 'garment',

        };

    }
/**
 * ==========================================================================
 * BUSINESS ROLE CLASSIFICATION V2
 * ==========================================================================
 *
 * Produces structured business-role intelligence without changing the
 * legacy ecosystem role returned by resolve().
 */
public function classify(Company $company): array
{
    /*
    |--------------------------------------------------------------------------
    | Legacy Ecosystem Role
    |--------------------------------------------------------------------------
    |
    | Backward compatibility for BusinessEcosystemService,
    | Build My Supply Chain and existing matching services.
    |
    */

    $ecosystemRole = $this->resolve($company);

    /*
    |--------------------------------------------------------------------------
    | Evidence
    |--------------------------------------------------------------------------
    */

    $evidence = [];

    /*
    |--------------------------------------------------------------------------
    | 1. Explicit Company Role
    |--------------------------------------------------------------------------
    */

    $explicitRole = filled($company->company_role)
        ? trim((string) $company->company_role)
        : null;

    if ($explicitRole !== null) {

        $canonicalRole =
            $this->canonicalResolver->resolve($explicitRole);

        if ($canonicalRole !== null) {

            $evidence[] = 'company_role:' . $explicitRole;

            return [
                'ecosystem_role' => $ecosystemRole,
                'canonical_role' => $canonicalRole,
                'specific_roles' => [$canonicalRole],
                'confidence' => 1.0,
                'source' => 'explicit_company_role',
                'evidence' => $evidence,
            ];
        }
    }

    /*
    |--------------------------------------------------------------------------
    | 2. Structured Product Intelligence
    |--------------------------------------------------------------------------
    */

    $productTexts = $company->relationLoaded('products')
        ? $company->products
            ->pluck('product_name')
            ->filter()
            ->map(fn ($value) => strtolower(trim((string) $value)))
            ->values()
            ->all()
        : [];

    foreach ($productTexts as $product) {
        $evidence[] = 'product:' . $product;
    }

    /*
    |--------------------------------------------------------------------------
    | 3. Legacy Evidence
    |--------------------------------------------------------------------------
    */

    if (filled($company->sektor)) {
        $evidence[] = 'sector:' . trim((string) $company->sektor);
    }

    if (filled($company->produk)) {
        $evidence[] = 'legacy_product:' . trim((string) $company->produk);
    }

    /*
    |--------------------------------------------------------------------------
    | 4. Infer Canonical Roles
    |--------------------------------------------------------------------------
    */

    $text = strtolower(
        implode(' ', array_filter([
            $company->sektor,
            $company->produk,
            ...$productTexts,
        ]))
    );

    $specificRoles = [];

    /*
    |--------------------------------------------------------------------------
    | Fiber
    |--------------------------------------------------------------------------
    */

    if (
        str_contains($text, 'viscose') ||
        str_contains($text, 'rayon')
    ) {
        $specificRoles[] = 'viscose_producer';
    }

    if (
        str_contains($text, 'staple fiber') ||
        str_contains($text, 'staple fibre')
    ) {
        $specificRoles[] = 'staple_fiber_manufacturer';
    }

    if (
        str_contains($text, 'polyester fiber') ||
        str_contains($text, 'polyester fibre')
    ) {
        $specificRoles[] = 'synthetic_fiber_manufacturer';
    }

    /*
    |--------------------------------------------------------------------------
    | Yarn / Spinning
    |--------------------------------------------------------------------------
    */

    if (
        str_contains($text, 'spinning') ||
        str_contains($text, 'spun yarn')
    ) {
        $specificRoles[] = 'yarn_spinner';
    }

    if (str_contains($text, 'ring spinning')) {
        $specificRoles[] = 'ring_spinning_mill';
    }

    if (
        str_contains($text, 'open end') ||
        str_contains($text, 'open-end')
    ) {
        $specificRoles[] = 'open_end_spinning_mill';
    }

    /*
    |--------------------------------------------------------------------------
    | Fabric
    |--------------------------------------------------------------------------
    */

    if (
        str_contains($text, 'weaving') ||
        str_contains($text, 'woven fabric')
    ) {
        $specificRoles[] = 'weaving_mill';
    }

    if (
        str_contains($text, 'knitting') ||
        str_contains($text, 'knitted fabric')
    ) {
        $specificRoles[] = 'knitting_mill';
    }

    if (str_contains($text, 'warp knitting')) {
        $specificRoles[] = 'warp_knitting_mill';
    }

    if (str_contains($text, 'circular knitting')) {
        $specificRoles[] = 'circular_knitting_mill';
    }

    /*
    |--------------------------------------------------------------------------
    | Processing
    |--------------------------------------------------------------------------
    */

    if (
        str_contains($text, 'dyeing') ||
        str_contains($text, 'finishing')
    ) {
        $specificRoles[] = 'dyeing_finishing_mill';
    }

    if (str_contains($text, 'digital printing')) {
        $specificRoles[] = 'digital_printing_company';
    } elseif (str_contains($text, 'printing')) {
        $specificRoles[] = 'printing_mill';
    }

    /*
    |--------------------------------------------------------------------------
    | Garment
    |--------------------------------------------------------------------------
    */

    if (
        str_contains($text, 'garment') ||
        str_contains($text, 'apparel')
    ) {
        $specificRoles[] = 'garment_manufacturer';
    }

    /*
    |--------------------------------------------------------------------------
    | Validate Against Canonical Taxonomy
    |--------------------------------------------------------------------------
    */

    $specificRoles = collect($specificRoles)
        ->filter(
            fn ($role) =>
                $this->canonicalResolver->isCanonical($role)
        )
        ->unique()
        ->values()
        ->all();

    /*
    |--------------------------------------------------------------------------
    | Canonical Primary Role
    |--------------------------------------------------------------------------
    */

    $canonicalRole =
        $specificRoles[0]
        ?? $this->canonicalFromEcosystemRole($ecosystemRole);

    /*
    |--------------------------------------------------------------------------
    | Confidence
    |--------------------------------------------------------------------------
    */

    $confidence = match (true) {

        count($specificRoles) >= 2 => 0.90,

        count($specificRoles) === 1 => 0.80,

        $canonicalRole !== null => 0.60,

        default => 0.0,
    };

    $source = match (true) {

        count($productTexts) > 0 =>
            'structured_product_inference',

        filled($company->produk) ||
        filled($company->sektor) =>
            'legacy_inference',

        default =>
            'ecosystem_fallback',
    };

    return [
        'ecosystem_role' => $ecosystemRole,
        'canonical_role' => $canonicalRole,
        'specific_roles' => $specificRoles,
        'confidence' => $confidence,
        'source' => $source,
        'evidence' => array_values(
            array_unique($evidence)
        ),
    ];
}

/**
 * Map legacy ecosystem roles to a safe canonical parent role.
 */
protected function canonicalFromEcosystemRole(
    string $ecosystemRole
): ?string {

    $role = match ($ecosystemRole) {

        'fiber' =>
            'fiber_manufacturer',

        'spinning' =>
            'yarn_spinner',

        'knitting' =>
            'knitting_mill',

        'weaving' =>
            'weaving_mill',

        'dyeing' =>
            'dyeing_finishing_mill',

        'garment' =>
            'garment_manufacturer',

        'home_textile' =>
            'home_textile_manufacturer',

        'technical_textile' =>
            'technical_textile_manufacturer',

        'brand' =>
            'brand_owner',

        'buying_office' =>
            'buying_office',

        default =>
            null,
    };

    return $role !== null &&
        $this->canonicalResolver->isCanonical($role)
            ? $role
            : null;
}
    
}